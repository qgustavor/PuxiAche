{
  "name": "puxiache",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PuxiAche — a spin-the-globe geography game!",
  "scripts": {
    "predev": "bun run scripts/check-boundary-data.mjs",
    "dev": "concurrently -k -n vite,firebase -c blue,yellow \"vite\" \"firebase emulators:start --only database --project demo-puxiache\"",
    "prebuild": "bun run scripts/check-boundary-data.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "build:countries": "bun run scripts/build-countries.mjs",
    "update:countries": "bun run scripts/update-countries.mjs"
  },
  "dependencies": {
    "@urlpack/msgpack": "^2.0.1",
    "@vueuse/core": "^14.4.0",
    "animejs": "^4.5.0",
    "canvas-confetti": "^1.9.4",
    "d3-geo": "^3.1.1",
    "lucide-vue-next": "^1.0.0",
    "three": "^0.185.1",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.9"
  },
  "devDependencies": {
    "@eslint/markdown": "^8.0.3",
    "@turf/turf": "^7.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.0",
    "eslint-plugin-vue": "^10.10.0",
    "firebase-tools": "^15.28.1",
    "neostandard": "^0.13.0",
    "vite": "^8.2.2"
  }
}
